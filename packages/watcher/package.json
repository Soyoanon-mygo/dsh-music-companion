{
  "name": "@dsh-music/watcher",
  "version": "0.3.0",
  "description": "Reads the Windows system media session (SMTC) and reports now-playing to music-hub. Works both as a DSH host plugin and as a standalone CLI.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cli": "./watcher.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "music-watcher": "./watcher.mjs"
  },
  "files": [
    "index.js",
    "watcher.mjs",
    "lib/ticker.mjs",
    "lib/netease.mjs",
    "lib/smtc.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "music",
    "smtc",
    "now-playing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soyoanon-mygo/dsh-music-companion.git",
    "directory": "packages/watcher"
  }
}
